  {
   "type": "timeseries",
   "title": "CPU by mode",
   "description": "Stacked share of CPU time. iowait = waiting on disk; steal = hypervisor took it; user/system = real work.",
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 50,
      "gradientMode": "opacity",
      "showPoints": "never",
      "spanNulls": 60000,
      "lineInterpolation": "smooth",
      "axisBorderShow": false,
      "axisSoftMin": 0,
      "stacking": {
       "mode": "normal",
       "group": "A"
      },
      "thresholdsStyle": {
       "mode": "off"
      }
     },
     "color": {
      "mode": "palette-classic"
     },
     "min": 0
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^viper( .*)?$"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#3987e5"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^hellcat( .*)?$"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#d95926"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^demon( .*)?$"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#199e70"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^ryzenous( .*)?$"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#c98500"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^flint2( .*)?$"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#d55181"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^tv( .*)?$"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#9085e9"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^soundbar( .*)?$"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#e66767"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^xbox( .*)?$"
      },
      "properties": [
       {
        "id": "color",
        "value": {
